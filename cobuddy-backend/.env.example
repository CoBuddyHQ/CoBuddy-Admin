NODE_ENV=development
PORT=4000

# ---------- DATABASE ----------
DATABASE_URL=postgresql://cobuddy:cobuddy@localhost:5432/cobuddy?schema=public&sslmode=prefer
DIRECT_URL=postgresql://cobuddy:cobuddy@localhost:5432/cobuddy?schema=public&sslmode=prefer

# ---------- REDIS ----------
REDIS_URL=redis://localhost:6379/0

# ---------- JWT ----------
JWT_ACCESS_SECRET=replace_me_access_secret_min_32_chars_please_use_env
JWT_REFRESH_SECRET=replace_me_refresh_secret_min_32_chars_please_use_env
JWT_MFA_SECRET=replace_me_mfa_secret_min_32_chars_please_use_env
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- BCRYPT ----------
BCRYPT_SALT_ROUNDS=12

# ---------- AES PII ----------
ENCRYPTION_KEY_PII=replace_me_with_64_char_hex_encoded_256_bit_key_here_xxxxxxxxxxxxxxxxxxx

# ---------- AWS S3 ----------
AWS_ACCESS_KEY_ID=AKIA_EXAMPLE
AWS_SECRET_ACCESS_KEY=replace_me_aws_secret
AWS_REGION=ap-south-1
S3_BUCKET_PRIVATE=cobuddy-private
S3_BUCKET_PUBLIC=cobuddy-public
S3_PRESIGN_UPLOAD_TTL=300
S3_PRESIGN_DOWNLOAD_TTL=60

# ---------- EMAIL ----------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_NAME="CoBuddy Admin"
EMAIL_FROM_ADDR=no-reply@cobuddy.in

# ---------- CORS / FRONTEND ----------
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
## Comma-separated ingress IPs/CIDRs only. Empty means forwarded headers are untrusted.
TRUST_PROXY=

# Swagger is disabled in production/staging. There are no Swagger basic-auth variables.
