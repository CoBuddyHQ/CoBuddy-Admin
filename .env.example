# Browser-visible API URL; set the HTTPS production API URL before building.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Restrict this browser key to your admin website origins and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional custom JavaScript map ID. Uses Google's DEMO_MAP_ID when omitted.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
