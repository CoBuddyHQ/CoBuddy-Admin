NODE_ENV=development
PORT=4000

# ---------- DATABASE ----------
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=
DIRECT_URL=

# ---------- REDIS ----------
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:replace-with-local-redis-password@localhost:6379/0
POSTGRES_PASSWORD=replace-with-local-postgres-password

# ---------- JWT ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_MFA_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- BCRYPT ----------
BCRYPT_SALT_ROUNDS=12

# ---------- AES PII ----------
ENCRYPTION_KEY_PII=replace_me_with_64_char_hex_encoded_256_bit_key_here_xxxxxxxxxxxxxxxxxxx

# ---------- AWS S3 ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_PRIVATE=cobuddy-private
S3_BUCKET_PUBLIC=cobuddy-public
S3_PRESIGN_UPLOAD_TTL=300
S3_PRESIGN_DOWNLOAD_TTL=60

# ---------- EMAIL ----------
RESEND_API_KEY=
EMAIL_FROM_NAME="CoBuddy Admin"
EMAIL_FROM_ADDR=no-reply@cobuddy.in

# ---------- CORS / FRONTEND ----------
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
## Comma-separated ingress IPs/CIDRs only. Empty means forwarded headers are untrusted.
TRUST_PROXY=

# Swagger is disabled in production/staging. There are no Swagger basic-auth variables.

# Optional broadcast delivery gateway (server-only; see AUDIT_REPAIR_REPORT.md).
# Gateway must resolve account IDs to push/SMS destinations and honor Idempotency-Key.
# NOTIFICATION_DELIVERY_URL=https://your-delivery-gateway.example/notifications
# NOTIFICATION_DELIVERY_TOKEN=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_SECRET=
