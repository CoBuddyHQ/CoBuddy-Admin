{
  "name": "cobuddy-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "build:vercel": "node scripts/check-vercel-config.mjs && next build",
    "check:production-config": "node scripts/check-production-config.mjs",
    "build:production": "npm run check:production-config && npm run audit:production && npm run build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:frontend": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "test:live": "node scripts/verify-live-workflows.mjs",
    "preview": "node scripts/start-preview.mjs",
    "verify:frontend": "npm run verify",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test:frontend && npm run build",
    "audit:production": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@tremor/react": "^3.18.7",
    "@vis.gl/react-google-maps": "^1.10.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.29.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
