{
  "name": "cobuddy-backend",
  "version": "0.1.0",
  "description": "CoBuddy Admin Panel Backend - NestJS + Prisma + PostgreSQL + Redis",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --ignore-path ../.prettierignore --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.cjs\" \"*.mjs\" \"*.json\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.cjs\" \"*.mjs\" \"*.json\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run build && node test/api-smoke.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate-dev": "prisma migrate dev",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "admin:reset-password": "ts-node -r dotenv/config prisma/set-admin-password.ts",
    "admin:bootstrap": "ts-node -r dotenv/config prisma/bootstrap-admin.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "lint:fix": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" --fix --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "test:unit": "jest --runInBand",
    "test:api": "npm run test:e2e",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "nestjs-throttler-storage-redis": "^0.5.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.0",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "overrides": {
    "lodash@^4.0.0": "4.18.1",
    "js-yaml@^4.0.0": "4.3.2",
    "multer@^2.0.0": "2.4.0",
    "body-parser@^1.0.0": "1.20.6",
    "qs@^6.0.0": "6.16.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@6.0.0": true
  }
}
