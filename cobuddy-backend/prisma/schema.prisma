generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, uuidOssp(map: "uuid-ossp"), pg_trgm]
}

// ============================================================
// STAFF / AUTH ENUMS
// ============================================================
enum StaffRole {
  SUPER_ADMIN
  MODERATOR
  SAFETY_OPERATOR
  FINANCE_ADMIN
  SUPPORT_AGENT
  SUPPORT_LEAD
  LEGAL_ADMIN
  CITY_OPS_MANAGER
  HR_ADMIN
}

enum EmployeeDepartment {
  TRUST_AND_SAFETY
  SUPPORT
  FINANCE
  LEGAL
  OPERATIONS
  ENGINEERING
  MANAGEMENT
  HR
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

// ============================================================
// USER ENUMS
// ============================================================
enum UserVerificationStatus {
  VERIFIED
  PENDING
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// ============================================================
// BOOKING / SESSION ENUMS
// ============================================================
enum BookingStatus {
  PENDING_COMPANION_ACCEPT
  REJECTED_BY_COMPANION
  ARRIVING
  IN_PROGRESS
  EXTENDED
  COMPLETED
  CUSTOMER_CANCELLED
  COMPANION_CANCELLED
  COMPANION_EARLY_END
  NO_SHOW_CUSTOMER
  NO_SHOW_COMPANION
  ADMIN_CANCELLED
}

// ============================================================
// FINANCIAL ENUMS
// ============================================================
enum PayoutStatus {
  PENDING
  ON_HOLD
  PROCESSING
  PAID
  FAILED
}

enum PayoutMethodType {
  BANK
  UPI
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum WalletTransactionCategory {
  WALLET_TOPUP
  BOOKING_CHARGE
  BOOKING_REFUND
  PLATFORM_FEE
  PAYOUT
  REFERRAL_BONUS
  PROMO_CREDIT
  DISPUTE_CREDIT
  DISPUTE_DEBIT
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum ReconciliationMatchStatus {
  MATCHED
  MISMATCHED
  PENDING
}

enum FraudFlagStatus {
  OPEN
  INVESTIGATING
  DISMISSED
  ACTION_TAKEN
}

// ============================================================
// MODERATION ENUMS
// ============================================================
enum VerificationApplicantType {
  CUSTOMER
  COMPANION
}

enum VerificationStatus {
  PENDING_MANUAL_REVIEW
  AUTO_APPROVED
  AUTO_REJECTED
  APPROVED
  REJECTED
  REQUEST_RESUBMISSION
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ESCALATED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  ESCALATED_LEGAL
  CLOSED
}

enum BanDuration {
  TEMPORARY_24H
  TEMPORARY_7D
  TEMPORARY_30D
  PERMANENT
}

enum AppealStatus {
  OPEN
  REVIEWING
  APPROVED
  REJECTED
  CLOSED
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REMOVED
  FLAGGED
}

// ============================================================
// SUPPORT ENUMS
// ============================================================
enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_USER
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketEscalationLevel {
  L1
  L2
  L3
}

// ============================================================
// SAFETY ENUMS
// ============================================================
enum SOSStatus {
  TRIGGERED
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED_FALSE_ALARM
  RESOLVED_REAL_INCIDENT
  ESCALATED_AUTHORITIES
}

enum GeofenceAlertType {
  ENTERED_RESTRICTED_ZONE
  EXITED_CITY_LIMITS
  STATIONARY_TOO_LONG
  DEVIATED_FROM_ROUTE
}

// ============================================================
// COMMUNICATION ENUMS
// ============================================================
enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum NotificationCategory {
  REQUEST
  SESSION
  SAFETY
  PAYOUT
  SUPPORT
  POLICY
  TRAINING
  SYSTEM
  WALLET
  PROMOTION
  REMINDER
}

// ============================================================
// MASTER DATA ENUMS
// ============================================================
enum InterestType {
  CUISINE
  ACTIVITY
  LIFESTYLE
}

enum ReviewTagPolarity {
  PRAISE
  CONCERN
}

enum ReviewTagAppliesTo {
  CUSTOMER_RATING_COMPANION
  COMPANION_RATING_CUSTOMER
  BOTH
}

enum CancellationReasonAppliesTo {
  CUSTOMER_CANCEL
  COMPANION_REJECT
  COMPANION_CANCEL
  COMPANION_EARLY_END
  ANY
}

enum KYCProvider {
  HYPERVERGE
  IDFY
  SIGNZY
  KARZA
}

// ============================================================
// MASTER DATA - WIRE FIRST PER README
// ============================================================
model City {
  id                String   @id @default(uuid())
  cityCode          String   @unique
  name              Json
  state             String
  country           String   @default("India")
  active            Boolean  @default(true)
  lat               Float?
  lng               Float?
  serviceHoursOpen  String?
  serviceHoursClose String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  areas              Area[]
  venues             Venue[]
  customers          Customer[]          @relation("CustomerCity")
  companions         Companion[]         @relation("CompanionCity")
  bookings           Booking[]
  geofenceZones      GeofenceZone[]      @relation("CityGeofenceZones")
  specialEvents      SpecialEvent[]      @relation("CitySpecialEvents")
  matchmakingConfigs MatchmakingConfig[] @relation("CityMatchmakingConfigs")

  @@index([active])
  @@index([state])
}

model Area {
  id        String   @id @default(uuid())
  cityId    String
  name      Json
  active    Boolean  @default(true)
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, active])
}

model Interest {
  id                  String       @id @default(uuid())
  name                Json
  type                InterestType
  icon                String?
  basePriceMultiplier Float        @default(1.0)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([type, active])
}

model SpokenLanguage {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppLanguage {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketCategory {
  id        String   @id @default(uuid())
  code      String   @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncidentType {
  id        String   @id @default(uuid())
  code      String   @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunicationStyleOption {
  id        String   @id @default(uuid())
  code      String   @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityPaceOption {
  id        String   @id @default(uuid())
  code      String   @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SessionDurationOption {
  id        String   @id @default(uuid())
  minutes   Int      @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationCategoryOption {
  id        String   @id @default(uuid())
  code      String   @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewTagOption {
  id        String             @id @default(uuid())
  code      String             @unique
  label     Json
  polarity  ReviewTagPolarity
  appliesTo ReviewTagAppliesTo
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model DisputeReason {
  id        String   @id @default(uuid())
  code      String   @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CancellationReason {
  id        String                      @id @default(uuid())
  code      String                      @unique
  label     Json
  appliesTo CancellationReasonAppliesTo
  active    Boolean                     @default(true)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
}

model KYCDocumentType {
  id        String   @id @default(uuid())
  code      String   @unique
  label     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlaceTypeConfig {
  id          String   @id @default(uuid())
  typeName    String   @unique
  displayName Json
  isAllowed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemDefault {
  id                 String   @id @default("singleton")
  defaultCurrency    String   @default("INR")
  defaultLanguage    String   @default("en")
  serviceHoursOpen   String   @default("08:00")
  serviceHoursClose  String   @default("23:00")
  platformFeePercent Float    @default(20.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================
// STAFF / AUTH
// ============================================================
model StaffEmployee {
  id                 String             @id @default(uuid())
  employeeId         String             @unique
  name               String
  email              String             @unique
  passwordHash       String
  phone              String?
  designation        String
  department         EmployeeDepartment
  reportingManagerId String?
  reportingManager   StaffEmployee?     @relation("EmployeeManager", fields: [reportingManagerId], references: [id])
  roles              StaffRole[]
  cityScopeIds       String[]
  status             EmployeeStatus     @default(ACTIVE)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean            @default(false)
  inviteToken        String?            @unique
  inviteExpiresAt    DateTime?
  inviteStatus       InviteStatus       @default(PENDING)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  subordinates    StaffEmployee[] @relation("EmployeeManager")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  assignedReports UserReport[]    @relation("ReportAssignee")

  sessions            StaffSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([status])
  @@index([department])
}

model StaffSession {
  id           String   @id @default(uuid())
  employeeId   String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  employee StaffEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  employeeId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  employee StaffEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  adminId        String
  adminName      String
  action         String
  moduleAffected String
  details        String?
  ipAddress      String?
  userAgent      String?
  resourceType   String?
  resourceId     String?
  oldValues      Json?
  newValues      Json?
  timestamp      DateTime @default(now())

  @@index([adminId, timestamp(sort: Desc)])
  @@index([moduleAffected, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([resourceType, resourceId])
}

// ============================================================
// CUSTOMERS
// ============================================================
model Customer {
  id                 String                 @id @default(uuid())
  name               String
  email              String?                @unique
  phone              String                 @unique
  passwordHash       String
  profilePicUrl      String?
  joinDate           DateTime               @default(now())
  verificationStatus UserVerificationStatus @default(PENDING)
  totalBookings      Int                    @default(0)
  walletBalance      Decimal                @default(0) @db.Decimal(12, 2)
  flagsCount         Int                    @default(0)
  status             UserStatus             @default(ACTIVE)
  cityId             String?
  dob                DateTime?
  gender             String?
  spokenLanguageIds  String[]
  preferenceJson     Json?
  lastActiveAt       DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  city            City?           @relation("CustomerCity", fields: [cityId], references: [id])
  bookings        Booking[]       @relation("CustomerBookings")
  tickets         SupportTicket[] @relation("CustomerTickets")
  reviewsWritten  Review[]        @relation("ReviewByCustomer")
  reviewsReceived Review[]        @relation("ReviewCustomerReceived")
  wallet          Wallet?

  @@index([status])
  @@index([verificationStatus])
  @@index([cityId])
  @@index([phone])
}

// ============================================================
// COMPANIONS
// ============================================================
model Companion {
  id                      String                 @id @default(uuid())
  name                    String
  email                   String?                @unique
  phone                   String                 @unique
  passwordHash            String
  profilePicUrl           String?
  joinDate                DateTime               @default(now())
  verificationStatus      UserVerificationStatus @default(PENDING)
  trustScore              Int                    @default(50)
  totalEarnings           Decimal                @default(0) @db.Decimal(12, 2)
  totalSessions           Int                    @default(0)
  status                  UserStatus             @default(ACTIVE)
  cityId                  String?
  city                    City?                  @relation("CompanionCity", fields: [cityId], references: [id])
  dob                     DateTime?
  gender                  String
  bio                     String?
  headline                String?
  spokenLanguageIds       String[]
  interestIds             String[]
  communicationStyleCodes String[]
  activityPaceCodes       String[]
  minSessionDurationMin   Int?
  maxSessionDurationMin   Int?
  pricingPerHourBase      Decimal?               @db.Decimal(10, 2)
  bankAccounts            BankAccount[]
  payoutPreference        PayoutMethodType?
  lastActiveAt            DateTime               @default(now())
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  bookings          Booking[]                @relation("CompanionBookings")
  payouts           Payout[]
  trustScoreHistory TrustScoreHistoryEntry[]
  reviewsWritten    Review[]                 @relation("ReviewByCompanion")
  reviewsReceived   Review[]                 @relation("ReviewCompanionReceived")
  tickets           SupportTicket[]          @relation("CompanionTickets")
  wallet            Wallet?
  applications      CompanionApplication[]

  @@index([status])
  @@index([cityId])
  @@index([verificationStatus])
  @@index([trustScore(sort: Desc)])
}

model BankAccount {
  id            String   @id @default(uuid())
  companionId   String
  accountName   String
  ifscCode      String
  accountNumber String
  accountLast4  String
  upiId         String?
  verified      Boolean  @default(false)
  preferred     Boolean  @default(false)
  createdAt     DateTime @default(now())

  companion      Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  payoutAttempts Payout[]

  @@index([companionId])
}

model TrustScoreHistoryEntry {
  id             String   @id @default(uuid())
  companionId    String
  oldScore       Int
  newScore       Int
  reason         String
  reasonCategory String?
  reportId       String?
  incidentId     String?
  date           DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([companionId, date(sort: Desc)])
}

// ============================================================
// BOOKINGS
// ============================================================
model Venue {
  id            String   @id @default(uuid())
  googlePlaceId String?  @unique
  name          String
  placeType     String
  cityId        String
  address       String
  lat           Float
  lng           Float
  photoUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  city     City      @relation(fields: [cityId], references: [id])
  bookings Booking[]

  @@index([cityId])
  @@index([placeType])
}

model Booking {
  id                      String        @id @default(uuid())
  bookingRef              String        @unique
  customerId              String
  companionId             String?
  cityId                  String
  activityLabel           String
  interestId              String?
  venueId                 String?
  venueSnapshot           Json?
  startTime               DateTime
  endTime                 DateTime
  durationMins            Int
  status                  BookingStatus
  statusChangedAt         DateTime      @default(now())
  customerCancelReasonId  String?
  companionCancelReasonId String?
  adminCancelNote         String?
  bookingAmount           Decimal       @db.Decimal(10, 2)
  platformFeePercent      Float         @default(20)
  platformFeeAmount       Decimal       @db.Decimal(10, 2)
  companionNetAmount      Decimal       @db.Decimal(10, 2)
  paymentStatus           String
  walletTransactionId     String?
  escrowReleaseAt         DateTime?
  extensionCount          Int           @default(0)
  originalBookingId       String?
  sosTriggered            Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  customer           Customer            @relation("CustomerBookings", fields: [customerId], references: [id])
  companion          Companion?          @relation("CompanionBookings", fields: [companionId], references: [id])
  city               City                @relation(fields: [cityId], references: [id])
  venue              Venue?              @relation(fields: [venueId], references: [id])
  sessionAuditLogs   SessionAuditLog[]
  walletTransactions WalletTransaction[]
  disputes           BookingDispute[]
  reports            UserReport[]
  sosAlerts          SOSAlert[]
  incidents          SafetyIncident[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([companionId, createdAt(sort: Desc)])
  @@index([status])
  @@index([startTime(sort: Desc)])
  @@index([cityId, status])
  @@index([bookingRef])
}

model SessionAuditLog {
  id        String   @id @default(uuid())
  bookingId String
  eventType String
  actorId   String?
  actorType String?
  details   Json?
  timestamp DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, timestamp(sort: Asc)])
}

model BookingDispute {
  id              String       @id @default(uuid())
  bookingId       String       @unique
  disputeReasonId String
  raisedBy        String
  status          RefundStatus @default(REQUESTED)
  description     String
  evidenceUrls    String[]
  resolutionNote  String?
  refundAmount    Decimal?     @db.Decimal(10, 2)
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ============================================================
// WALLETS + FINANCIAL
// ============================================================
model Wallet {
  id            String    @id @default(uuid())
  ownerType     String
  customerId    String?   @unique
  companionId   String?   @unique
  currency      String    @default("INR")
  balance       Decimal   @default(0) @db.Decimal(14, 2)
  ledgerVersion Int       @default(0)
  lastTopupAt   DateTime?
  lastSpendAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer     Customer?           @relation(fields: [customerId], references: [id])
  companion    Companion?          @relation(fields: [companionId], references: [id])
  transactions WalletTransaction[]

  @@index([ownerType, balance(sort: Desc)])
}

model WalletTransaction {
  id              String                    @id @default(uuid())
  walletId        String
  transactionType TransactionType
  category        WalletTransactionCategory
  amount          Decimal                   @db.Decimal(14, 2)
  balanceAfter    Decimal                   @db.Decimal(14, 2)
  description     String
  status          TransactionStatus         @default(SUCCESS)
  bookingId       String?
  payoutId        String?
  invoiceId       String?
  refundId        String?
  gatewayTxnId    String?
  metadata        Json?
  createdAt       DateTime                  @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id])
  payout  Payout?  @relation(fields: [payoutId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([status, createdAt(sort: Desc)])
  @@index([category])
}

model Payout {
  id              String       @id @default(uuid())
  payoutRef       String       @unique
  companionId     String
  bankAccountId   String?
  amount          Decimal      @db.Decimal(12, 2)
  periodStart     DateTime
  periodEnd       DateTime
  status          PayoutStatus @default(PENDING)
  dueDate         DateTime
  holdReason      String?
  processedAt     DateTime?
  utrNumber       String?
  gatewayPayoutId String?
  failureMessage  String?
  paidByAdminId   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  companion          Companion           @relation(fields: [companionId], references: [id])
  bankAccount        BankAccount?        @relation(fields: [bankAccountId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([companionId, periodStart(sort: Desc)])
  @@index([status])
  @@index([dueDate])
  @@index([payoutRef])
}

model Refund {
  id              String       @id @default(uuid())
  bookingId       String
  requestedById   String
  requestedByType String
  amount          Decimal      @db.Decimal(10, 2)
  status          RefundStatus @default(REQUESTED)
  reason          String
  approvedById    String?
  processedAt     DateTime?
  gatewayRefundId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([bookingId])
  @@index([status])
}

model TaxInvoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  customerId     String?
  companionId    String?
  bookingId      String?
  invoiceDate    DateTime      @default(now())
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  gstPercent     Float         @default(18)
  gstAmount      Decimal       @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  pdfUrl         String?
  billingAddress Json?
  taxNumber      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([invoiceNumber])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status])
}

model ReconciliationRecord {
  id                 String                    @id @default(uuid())
  reconciliationDate DateTime
  gateway            String
  internalTxnId      String?
  internalAmount     Decimal?                  @db.Decimal(12, 2)
  internalDate       DateTime?
  gatewayTxnId       String?
  gatewayAmount      Decimal?                  @db.Decimal(12, 2)
  gatewayDate        DateTime?
  matchStatus        ReconciliationMatchStatus @default(PENDING)
  mismatchNote       String?
  createdAt          DateTime                  @default(now())

  @@index([reconciliationDate(sort: Desc)])
  @@index([matchStatus])
  @@index([gateway, gatewayTxnId])
  @@index([internalTxnId])
}

model FraudFlag {
  id           String          @id @default(uuid())
  userId       String
  userType     String
  category     String
  status       FraudFlagStatus @default(OPEN)
  description  String
  riskScore    Int
  evidenceJson Json?
  assignedToId String?
  actionsTaken String[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, userType])
  @@index([status])
  @@index([category, createdAt(sort: Desc)])
}

// ============================================================
// KYC VERIFICATION + COMPANION APPLICATION
// ============================================================
model VerificationCase {
  id                       String                    @id @default(uuid())
  caseRef                  String                    @unique
  applicantId              String
  applicantType            VerificationApplicantType
  provider                 KYCProvider?
  documentType             String
  idDocumentUrl            String
  selfieUrl                String
  backgroundDeclarationUrl String?
  faceMatchScore           Int?
  livenessPass             Boolean?
  documentValid            Boolean?
  status                   VerificationStatus        @default(PENDING_MANUAL_REVIEW)
  reviewNotes              String?
  reviewedByStaffId        String?
  autoRunAt                DateTime?
  decidedAt                DateTime?
  submittedAt              DateTime                  @default(now())
  auditTrail               VerificationAuditEvent[]

  @@index([applicantId, applicantType])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
  @@index([caseRef])
}

model VerificationAuditEvent {
  id        String   @id @default(uuid())
  caseId    String
  timestamp DateTime @default(now())
  action    String
  actor     String
  actorId   String?
  notes     String?

  kycCase VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, timestamp(sort: Asc)])
}

model VerificationThreshold {
  id                   String      @id @default("singleton")
  autoApproveThreshold Int         @default(90)
  autoRejectThreshold  Int         @default(30)
  livenessRequired     Boolean     @default(true)
  enabledProvider      KYCProvider @default(HYPERVERGE)
  updatedAt            DateTime    @updatedAt
}

model CompanionApplication {
  id                String   @id @default(uuid())
  companionId       String?  @unique
  firstName         String
  lastName          String
  phone             String
  email             String?
  cityId            String
  cvUrl             String?
  portfolioUrls     String[]
  applicationStatus String
  reviewNotes       String?
  reviewedByStaffId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companion Companion? @relation(fields: [companionId], references: [id])

  @@index([applicationStatus, createdAt(sort: Desc)])
  @@index([cityId])
}

// ============================================================
// MODERATION
// ============================================================
model UserReport {
  id               String         @id @default(uuid())
  reportRef        String         @unique
  reporterId       String
  reporterType     String
  reportedUserId   String
  reportedUserType String
  categoryCode     String
  description      String
  evidenceUrls     String[]
  bookingId        String?
  status           ReportStatus   @default(OPEN)
  assignedToId     String?
  assignedTo       StaffEmployee? @relation("ReportAssignee", fields: [assignedToId], references: [id])
  notes            Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt(sort: Desc)])
  @@index([reportRef])
  @@index([reportedUserId, reportedUserType])
}

model UserBan {
  id         String      @id @default(uuid())
  userId     String
  userType   String
  reason     String
  reportId   String?
  duration   BanDuration
  startsAt   DateTime    @default(now())
  endsAt     DateTime?
  bannedById String
  liftedAt   DateTime?
  liftedById String?
  liftReason String?
  createdAt  DateTime    @default(now())

  @@index([userId, userType])
  @@index([startsAt(sort: Desc)])
}

model Review {
  id               String                 @id @default(uuid())
  bookingId        String
  byCustomerId     String
  toCompanionId    String?
  byCompanionId    String?
  toCustomerId     String?
  rating           Int
  text             String?
  tagCodes         String[]
  moderationStatus ReviewModerationStatus @default(PENDING)
  moderationNote   String?
  moderatedById    String?
  createdAt        DateTime               @default(now())

  byCustomer  Customer   @relation("ReviewByCustomer", fields: [byCustomerId], references: [id])
  toCompanion Companion? @relation("ReviewCompanionReceived", fields: [toCompanionId], references: [id])
  byCompanion Companion? @relation("ReviewByCompanion", fields: [byCompanionId], references: [id])
  toCustomer  Customer?  @relation("ReviewCustomerReceived", fields: [toCustomerId], references: [id])

  @@unique([bookingId, byCustomerId, toCompanionId])
  @@index([byCustomerId])
  @@index([toCompanionId])
  @@index([moderationStatus])
  @@index([createdAt(sort: Desc)])
}

model UserBanAppeal {
  id           String       @id @default(uuid())
  banId        String
  appealReason String
  status       AppealStatus @default(OPEN)
  reviewerId   String?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?

  @@index([banId])
  @@index([status])
}

// ============================================================
// SAFETY OPERATIONS
// ============================================================
model SOSAlert {
  id                   String    @id @default(uuid())
  alertRef             String    @unique
  userId               String
  userType             String
  bookingId            String?
  lat                  Float
  lng                  Float
  status               SOSStatus @default(TRIGGERED)
  audioClipUrl         String?
  acknowledgedById     String?
  acknowledgedAt       DateTime?
  resolvedNote         String?
  resolvedById         String?
  resolvedAt           DateTime?
  authoritiesContacted Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([alertRef])
}

model SafetyIncident {
  id                     String         @id @default(uuid())
  incidentRef            String         @unique
  incidentTypeCode       String
  involvedCustomerIds    String[]
  involvedCompanionIds   String[]
  status                 IncidentStatus @default(OPEN)
  legalEscalation        Boolean        @default(false)
  description            String
  evidenceUrls           String[]
  preserveEvidence       Boolean        @default(false)
  assignedInvestigatorId String?
  investigatorNotes      Json?
  bookingId              String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([incidentTypeCode])
  @@index([legalEscalation])
  @@index([createdAt(sort: Desc)])
  @@index([incidentRef])
}

model GeofenceZone {
  id              String   @id @default(uuid())
  zoneName        String
  cityId          String
  zoneType        String
  boundaryGeoJson Json
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  city City @relation("CityGeofenceZones", fields: [cityId], references: [id])

  @@index([cityId, zoneType])
}

enum GeofenceAlertStatus {
  INVESTIGATING
  ESCALATED
  RESOLVED
}

model GeofenceAlertEvent {
  id        String              @id @default(uuid())
  zoneId    String
  bookingId String?
  userId    String
  userType  String
  alertType GeofenceAlertType
  lat       Float
  lng       Float
  seen      Boolean             @default(false)
  status    GeofenceAlertStatus @default(INVESTIGATING)
  createdAt DateTime            @default(now())

  @@index([seen, createdAt(sort: Desc)])
  @@index([zoneId, createdAt(sort: Desc)])
}

model EmergencyWorkflowConfig {
  id                                   String   @id @default("singleton")
  acknowledgementSlaSeconds            Int      @default(30)
  escalationSlaSeconds                 Int      @default(300)
  authoritiesContactIfNoResolveSeconds Int      @default(600)
  onCallTeamIds                        String[]
  updatedAt                            DateTime @updatedAt
}

model MinorAgeEscalation {
  id           String   @id @default(uuid())
  userId       String
  userType     String
  reportedById String
  evidenceUrls String[]
  status       String
  reviewNote   String?
  reviewedById String?
  createdAt    DateTime @default(now())

  @@index([status])
}

// ============================================================
// SUPPORT TICKETS
// ============================================================
model SupportTicket {
  id               String                @id @default(uuid())
  ticketRef        String                @unique
  userId           String
  userName         String
  userType         String
  customerId       String?
  companionId      String?
  categoryCode     String
  priority         SupportTicketPriority @default(MEDIUM)
  status           SupportTicketStatus   @default(OPEN)
  subject          String
  escalationLevel  TicketEscalationLevel @default(L1)
  assignedToId     String?
  slaDeadline      DateTime?
  resolutionNote   String?
  relatedBookingId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  assignedTo StaffEmployee?     @relation("TicketAssignee", fields: [assignedToId], references: [id])
  customer   Customer?          @relation("CustomerTickets", fields: [customerId], references: [id])
  companion  Companion?         @relation("CompanionTickets", fields: [companionId], references: [id])
  messages   TicketMessage[]
  audit      TicketAuditEvent[]

  @@index([status])
  @@index([assignedToId, status])
  @@index([escalationLevel])
  @@index([slaDeadline])
  @@index([categoryCode])
  @@index([ticketRef])
  @@index([customerId])
  @@index([companionId])
}

model TicketMessage {
  id             String   @id @default(uuid())
  ticketId       String
  senderId       String
  senderType     String
  message        String
  attachmentUrls String[]
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Asc)])
}

model TicketAuditEvent {
  id        String   @id @default(uuid())
  ticketId  String
  event     String
  actorId   String?
  oldValue  Json?
  newValue  Json?
  timestamp DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, timestamp(sort: Asc)])
}

// ============================================================
// NOTIFICATIONS
// ============================================================
model NotificationTemplate {
  id          String                @id @default(uuid())
  templateKey String                @unique
  category    NotificationCategory
  subject     Json
  body        Json
  channels    NotificationChannel[]
  active      Boolean               @default(true)
}

model NotificationDispatch {
  id            String              @id @default(uuid())
  templateKey   String
  recipientId   String
  recipientType String
  channel       NotificationChannel
  status        String
  payload       Json
  sentAt        DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())

  @@index([recipientId, recipientType])
  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model StaffNotification {
  id          String   @id @default(uuid())
  staffId     String
  title       String
  body        String
  type        String
  read        Boolean  @default(false)
  relatedId   String?
  relatedType String?
  createdAt   DateTime @default(now())

  @@index([staffId, read, createdAt(sort: Desc)])
}

// ============================================================
// DISCOVERY + PLATFORM CONFIG
// ============================================================
model DiscoveryRankingConfig {
  id                       String   @id @default("singleton")
  trustScoreWeight         Float    @default(0.35)
  ratingWeight             Float    @default(0.25)
  responseTimeWeight       Float    @default(0.15)
  acceptRateWeight         Float    @default(0.10)
  sessionCompletionWeight  Float    @default(0.10)
  proximityBonusWeight     Float    @default(0.05)
  minTrustScoreForTopPool  Int      @default(80)
  minAcceptanceRatePercent Int      @default(70)
  newCompanionBoostPercent Float    @default(20)
  updatedAt                DateTime @updatedAt
}

model MatchmakingConfig {
  id                          String   @id @default(uuid())
  cityId                      String   @unique
  searchRadiusKm              Float    @default(25)
  maxCompanionSuggestions     Int      @default(10)
  companionAcceptDeadlineMins Int      @default(15)
  autoRetryCount              Int      @default(2)
  updatedAt                   DateTime @updatedAt

  city City @relation("CityMatchmakingConfigs", fields: [cityId], references: [id])
}

model SpecialEvent {
  id          String   @id @default(uuid())
  cityId      String
  title       Json
  description Json
  bannerUrl   String
  startDate   DateTime
  endDate     DateTime
  discountPct Float?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  city City @relation("CitySpecialEvents", fields: [cityId], references: [id])

  @@index([cityId, active])
}

model PolicyDocument {
  id          String   @id @default(uuid())
  docKey      String   @unique
  title       String
  content     String
  version     String
  effectiveOn DateTime
  publishedBy String?
  createdAt   DateTime @default(now())

  @@index([docKey, effectiveOn(sort: Desc)])
}

model TrainingModule {
  id           String     @id @default(uuid())
  title        String
  audience     String
  requiredRole StaffRole?
  contentUrl   String
  quizJson     Json?
  passPctReq   Int        @default(80)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

model DataPrivacyRequest {
  id              String    @id @default(uuid())
  requestRef      String    @unique
  userId          String
  userType        String
  requestType     String
  status          String
  statusDetails   String?
  requestedFields String[]
  fulfillmentUrl  String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([requestType])
  @@index([userId, userType])
}

model LegalRequest {
  id                String   @id @default(uuid())
  requestRef        String   @unique
  authority         String
  caseReference     String
  requestType       String
  targetUserId      String
  preserveUntil     DateTime
  fulfillmentStatus String
  documentsUrl      String?
  approvedByLegalId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fulfillmentStatus])
  @@index([preserveUntil])
}

model AppConfig {
  id          String   @id @default(uuid())
  configKey   String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model ReferralCode {
  id           String   @id @default(uuid())
  code         String   @unique
  ownerId      String
  ownerType    String
  signupBonus  Decimal  @db.Decimal(10, 2)
  refereeBonus Decimal  @db.Decimal(10, 2)
  maxUsages    Int?
  usagesCount  Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Announcement {
  id             String    @id @default(uuid())
  title          Json
  body           Json
  targetAudience String
  targetCityIds  String[]
  publishedAt    DateTime
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
}
