# Browser-visible API URL; set the HTTPS production API URL before building.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Restrict this browser key to your admin website origins and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional custom JavaScript map ID. Uses Google's DEMO_MAP_ID when omitted.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Local Admin Compose backend/database values. Replace placeholders with private local values.
POSTGRES_PASSWORD=replace-with-local-postgres-password
REDIS_PASSWORD=replace-with-local-redis-password
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
JWT_MFA_SECRET=replace-with-local-mfa-secret
ENCRYPTION_KEY_PII=replace-with-a-64-character-hex-key
INTERNAL_SERVICE_SECRET=replace-with-a-shared-local-service-secret
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
