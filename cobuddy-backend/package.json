{
  "name": "cobuddy-backend",
  "version": "0.1.0",
  "description": "CoBuddy Admin Panel Backend - NestJS + Prisma + PostgreSQL + Redis",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --ignore-path .prettierignore --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.cjs\" \"*.mjs\" \"*.json\"",
    "format:check": "prettier --ignore-path .prettierignore --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.cjs\" \"*.mjs\" \"*.json\"",
    "check:production-config": "npm run build && node scripts/check-production-config.cjs",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run db:validate && npm run typecheck && npm run format:check && npm run lint && npm run test:unit && npm run build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run build && node test/api-smoke.cjs && node test/dispute-flow.cjs && node test/rate-limit.cjs && node test/admin-workflows.cjs && node test/application-assignment.cjs && node test/verification-scope.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate-dev": "prisma migrate dev",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:inventory-demo": "ts-node prisma/inventory-legacy-demo.ts",
    "db:cleanup-demo": "ts-node prisma/cleanup-legacy-demo.ts",
    "admin:reset-password": "ts-node -r dotenv/config prisma/set-admin-password.ts",
    "admin:bootstrap": "ts-node -r dotenv/config prisma/bootstrap-admin.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "lint:fix": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" --fix --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "test:unit": "jest --runInBand",
    "test:api": "npm run test:e2e",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.0",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "overrides": {
    "lodash@^4.0.0": "4.18.1",
    "js-yaml@^4.0.0": "4.3.2",
    "js-yaml@^5.0.0": "5.4.3",
    "multer@^2.0.0": "2.4.0",
    "body-parser@^1.0.0": "1.20.6",
    "qs@^6.0.0": "6.16.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@6.0.0": true
  }
}
